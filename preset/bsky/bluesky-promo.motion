}

text serviceBText {
  parent portable
  value "SERVICE B"
  center
  layer text
  x 650
  y 180
  width 220
  size 23
  weight 760
  color #FFFFFF
  opacity 1
}

path protocolLine {
  parent portable
  d "M360 -20 C460 -170 540 -180 560 -180 C560 -180 520 130 560 180"
  fill none
  stroke #1185FE
  strokeWidth 8
  opacity 1
  animation drawSVG(delay .78s duration .85s ease power3.out)
}

path protocolGuide {
  parent portable
  guide
  d "M0 0 C100 -150 180 -160 200 -160 C200 -160 160 150 200 200"
}

image portableButterfly {
  source bskyIcon
  parent portable
  center
  layer details
  x 360
  y -20
  width 84
  motionPath protocolGuide
  motionPathProgress 0
  motionPathRotate
  shadow 22
  opacity 1
}

animate portableButterfly {
  to { motionPathProgress 1 }
  delay .85s
  duration 1.35s
  easing power3.inOut
}

