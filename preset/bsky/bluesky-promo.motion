canvas {
  size 1920x1080
  fps 60
  duration 25s
  background #071626
}

theme {
  background #071626
  surface #FFFFFF
  raised #E8F4FF
  edge #C7E5FF
  text #091728
  muted #526B83
  accent #1185FE
  secondary #65B8FF
  gradientFrom #EAF6FF
  gradientTo #1185FE
  displayFont "Space Grotesk, Inter, sans-serif"
  radius 28
  shadow 38
  duration .55s
  stagger .06s
  easing power3.out
}

import "/preset/bsky/blesky-banner.jpg" as heroBanner
import "/preset/bsky/bluesky-icon.svg" as bskyIcon
import "/preset/bsky/bsky-banner-2-with-phone-mockup.jpg" as phoneBanner
import "/preset/bsky/bsky-banner-3-phoen-mockup.png" as neonBanner
import "/preset/bsky/bsky-banner-notification.png" as notificationBanner
import "/preset/bsky/bsky-feed-ui.png" as feedUI
import "/preset/bsky/bsky-post-ui.png" as postUI
import "/preset/bsky/bsky-profile-page.png" as profileUI
import "/preset/bsky/bsky-sidebar-search-and-navigations.png" as sidebarUI

scene launch {
  start 0s
  duration 2.2s
  background #071626
}

overlay launchAtmosphere {
  parent launch
  layer background
  opacity 0
  backgroundEffect particles(duration 2.2s opacity .22 intensity .7 gradientFrom #65B8FF gradientTo #1185FE)
}

path launchArcA {
  parent launch
  d "M-360 40 C-210 -290 190 -290 360 40"
  fill none
  stroke #1185FE
  strokeWidth 10
  opacity .45
  animation drawSVG(delay .05s duration .8s ease power3.out)
}

path launchArcB {
  parent launch
  d "M-300 130 C-120 330 180 320 320 90"
  fill none
  stroke #65B8FF
  strokeWidth 6
  opacity .3
  animation drawSVG(delay .18s duration .9s ease power3.out)
}

image launchIcon {
  source bskyIcon
  parent launch
  center
  layer hero
  y -105
  width 320
  shadow 38
  opacity 1
  animation drawSVG(delay .08s duration .85s anticipation 90ms overshoot 1.06 ease power3.out)
}

text launchTitle {
  parent launch
  value "BLUESKY"
  center
  layer text
  y 165
  width 1000
  size 98
  tracking 8
  weight 800
  color #FFFFFF
  opacity 1
  textAnimation maskReveal(split chars stagger 28ms direction up delay .52s duration .52s ease power3.out)
}

text launchTagline {
  parent launch
  value "Open social. Built around you."
  center
  layer text
  y 270
  width 900
  size 28
  weight 520
  color #9CCFFF
  opacity 1
  textAnimation maskReveal(split lines direction up delay .9s duration .42s ease power3.out)
}

scene compose {
  start 2.2s
  duration 3.3s
  background #071626
}

overlay composeWipe {
  parent compose
  shape rect
  layer background
  width 1920
  height 1080
  fill #071626
  opacity 1
  animation shapeWipe(duration .42s direction right ease power3.out)
}

image composeReference {
  source postUI
  parent compose
  center
  layer supporting
  width 1760
  blur 9
  opacity .09
}

text composeKicker {
  parent compose
  value "CREATE A POST"
  center
  layer text
  x -650
  y -285
  width 520
  textAlign left
  size 22
  weight 760
  color #65B8FF
  opacity 1
  textAnimation maskReveal(split lines direction up delay .16s duration .4s ease power3.out)
}

text composeTitle {
  parent compose
  value "Say what matters."
  center
  layer text
  x -500
  y -185
  width 820
  textAlign left
  size 68
  weight 790
  color #FFFFFF
  opacity 1
  textAnimation maskReveal(split lines direction up delay .28s duration .52s ease power3.out)
}

group composer {
  parent compose
  x 315
  y 35
  opacity 1
}

overlay composerSurface {
  parent composer
  shape roundrect
  layer supporting
  width 1020
  height 650
  radius 34
  fill #111C2A
  stroke #2D4258
  strokeWidth 2
  shadow 56
  opacity 1
  animation cardReveal(delay .18s duration .55s ease power3.out)
}

image composerAvatar {
  source bskyIcon
  parent composer
  center
  layer details
  x -405
  y -245
  width 82
  opacity 1
  animation springIn(delay .38s duration .55s distance 40 ease power3.out)
}

text composerName {
  parent composer
  value "Bluesky  @bsky.app"
  center
  layer text
  x -200
  y -250
  width 360
  textAlign left
  size 23
  weight 720
  color #DCEEFF
  opacity 1
  textAnimation maskReveal(split lines direction up delay .42s duration .38s ease power3.out)
}

text composerCopy {
  parent composer
  value "Building a better public conversation."
  center
  layer text
  x 20
  y -135
  width 800
  textAlign left
  size 34
  weight 560
  color #FFFFFF
  opacity 1
  textAnimation typewriter(delay .6s duration .95s ease linear)
}

image composerMedia {
  source heroBanner
  parent composer
  center
  layer content
  x 20
  y 115
  width 730
  radius 22
  shadow 28
  opacity 1
  animation maskReveal(delay 1.22s duration .48s direction up ease power3.out)
}

component postButton {
  type button
  parent composer
  label "Post"
  x 405
  y -250
  color #1185FE
  scale .86
  opacity 1
}

component postCursor {
  type cursor
  parent composer
  clicks postButton
  clickAt 2.05s
  scale .9
  opacity 1
}

component postToast {
  type notification
  parent compose
  reactsTo postButton
  label "Posted"
  detail "Now in Following."
  x 500
  y 380
  scale .86
  opacity 1
}

animate composer {
  keyframes {
    0% { x 380 y 55 scale .95 }
    55% { x 315 y 35 scale 1 }
    78% { x 315 y 35 scale 1 }
    100% { x 250 y -10 scale .9 }
  }
  duration 3.6s
  easing power3.inOut
}

scene feed {
  start 5.5s
  duration 3.8s
  background #EAF6FF
}

overlay feedWipe {
  parent feed
  shape rect
  layer background
  width 1920
  height 1080
  fill #EAF6FF
  opacity 1
  animation shapeWipe(duration .42s direction left ease power3.out)
}

text feedKicker {
  parent feed
  value "FOLLOWING · CHRONOLOGICAL"
  center
  layer text
  x -630
  y -290
  width 610
  textAlign left
  size 22
  weight 760
  color #1185FE
  opacity 1
}

text feedTitle {
  parent feed
  value "Posted.\nNow in your feed."
  center
  layer text
  x -535
  y -85
  width 760
  textAlign left
  size 72
  lineHeight .95
  weight 790
  color #091728
  opacity 1
}

text feedBody {
  parent feed
  value "New posts arrive in order.\nNo mystery ranking."
  center
  layer text
  x -530
  y 165
  width 760
  textAlign left
  size 27
  lineHeight 1.25
  weight 500
  color #526B83
  opacity 1
}

group feedCard {
  parent feed
  x 390
  y 20
  opacity 1
}

overlay feedCardSurface {
  parent feedCard
  shape roundrect
  layer supporting
  width 800
  height 710
  radius 30
  fill #111C2A
  shadow 52
  opacity 1
}

image feedAvatar {
  source bskyIcon
  parent feedCard
  center
  layer details
  x -320
  y -275
  width 74
  opacity 1
}

text feedName {
  parent feedCard
  value "Bluesky  @bsky.app  ·  now"
  center
  layer text
  x -100
  y -282
  width 450
  textAlign left
  size 22
  weight 720
  color #DCEEFF
  opacity 1
}

text feedCopy {
  parent feedCard
  value "Building a better public conversation."
  center
  layer text
  y -210
  width 680
  textAlign left
  size 28
  weight 540
  color #FFFFFF
  opacity 1
}

image feedMedia {
  source heroBanner
  parent feedCard
  center
  layer content
  y 30
  width 670
  radius 20
  opacity 1
  animation maskReveal(delay .08s duration .38s direction up ease power3.out)
}

text feedHeart {
  parent feedCard
  value "♥"
  center
  layer text
  x -275
  y 300
  width 60
  size 31
  weight 760
  color #1185FE
  opacity 1
  textAnimation scaleReveal(delay .82s duration .4s ease power3.out)
}

text feedLikes {
  parent feedCard
  value 0
  countDecimals 0
  center
  layer text
  x -220
  y 300
  width 80
  textAlign left
  size 24
  weight 720
  color #A8C3DA
  opacity 1
}

animate feedLikes {
  from { value 12 opacity 0 scale .9 }
  to { value 128 opacity 1 scale 1 }
  delay .88s
  duration .72s
  easing power3.out
}

text feedActions {
  parent feedCard
  value "↻ 24          💬 18"
  center
  layer text
  x 95
  y 300
  width 400
  size 24
  weight 650
  color #A8C3DA
  opacity 1
  textAnimation maskReveal(split words stagger 55ms direction up delay 1s duration .4s ease power3.out)
}

group nextPost {
  parent feed
  x 390
  y 435
  opacity 1
}

overlay nextPostSurface {
  parent nextPost
  shape roundrect
  layer supporting
  width 800
  height 150
  radius 28
  fill #FFFFFF
  shadow 26
  opacity 1
  animation dynamicSlide(delay 1.35s duration .5s direction up distance 120 ease power3.out)
}

text nextPostText {
  parent nextPost
  value "A new post just arrived  ·  2s"
  center
  layer text
  width 650
  textAlign left
  size 24
  weight 650
  color #091728
  opacity 1
  textAnimation maskReveal(split lines direction up delay 1.48s duration .38s ease power3.out)
}

