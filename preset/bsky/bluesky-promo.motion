overlay serviceA {
  parent portable
  shape roundrect
  layer content
  x 650
  y -180
  width 260
  height 130
  radius 24
  fill #E0F1FF
  stroke #65B8FF
  strokeWidth 3
  shadow 22
  opacity 1
}

text serviceAText {
  parent portable
  value "SERVICE A"
  center
  layer text
  x 650
  y -180
  width 220
  size 23
  weight 760
  color #0B355B
  opacity 1
}

overlay serviceB {
  parent portable
  shape roundrect
  layer content
  x 650
  y 180
  width 260
  height 130
  radius 24
