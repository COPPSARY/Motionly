scene feedShowcase {
  start 16.5s
  duration 2s
  background #071626
}

image feedShowcaseMedia {
  source feedUI
  parent feedShowcase
  center
  layer hero
  width 1920
  opacity 1
}

animate feedShowcaseMedia {
  from { y 45 scale 1 }
  to { y -45 scale 1.05 }
  duration 2s
  easing sine.inOut
}

overlay feedShowcaseShade {
  parent feedShowcase
  shape roundrect
  layer details
  x -600
  y -390
  width 620
  height 90
  radius 28
  fill rgba(7,22,38,.88)
  shadow 24
  opacity 1
  animation popover(delay .18s duration .4s ease power3.out)
}

text feedShowcaseLabel {
  parent feedShowcase
  value "THE FEED, YOUR WAY"
  center
  layer text
  x -600
  y -390
  width 560
  size 26
  weight 760
  color #FFFFFF
