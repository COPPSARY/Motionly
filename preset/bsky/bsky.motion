// Bluesky product launch — rebuilt on the motion system.
//
// Structure: seven beats, no scene roots. The composition persists and is
// reframed by the camera instead of being cleared between shots, so the film
// reads as one continuous move rather than a stack of slides.
//
// Beat            Window        Route           Carries
// open            0.0–3.2s      stagedReveals   brand mark, wordmark, promise
// compose         3.2–6.6s      stagedReveals   posting, real post UI in a browser
// feed            6.6–10.6s     cameraIntent    custom feeds, feed UI + feed choices
// identity        10.6–14.2s    cameraIntent    AT Protocol, profile, handle
// reach           14.2–17.8s    stagedReveals   every device, phone showcase
// app             17.8–21.2s    cameraIntent    one app, product hero
// close           21.2–25.0s    stagedReveals   brand lockup and URL
//
// Doctrine: arrivals reveal binary and are staged within their beat, cascades
// accelerate and land inside one beat, and showcases carry each shot with a
// camera push so no stretch sits still. Boundaries reframe with the camera
// rather than handing a shared element across: consecutive showcases occupy the
// same slot, so a carrier would stack two screenshots on top of each other.
// Each showcase therefore leaves before the next one arrives.
// Verify with: npm run inspect:motion -- preset/bsky/bsky.motion --strict

canvas {
  size 1920x1080
  fps 60
  duration 25s
  background #071626
}

theme {
  background #071626
  surface #0B1A2B
  raised #10263C
  edge #1E3550
  text #FFFFFF
  muted #A8C3DA
  accent #1185FE
  secondary #65B8FF
  gradientFrom #65B8FF
  gradientTo #1185FE
  displayFont "Space Grotesk, Inter, sans-serif"
  radius 32
  shadow 48
  duration .6s
  stagger .06s
  easing power3.out
}

camera {
  zoom 1
  x 0
  y 0
  rotation 0
}

import "/preset/bsky/bluesky-icon.svg" as bskyIcon
import "/preset/bsky/bsky-post-ui.png" as postCard
import "/preset/bsky/bsky-feed-ui.png" as feedApp
import "/preset/bsky/bsky-profile-page.png" as profilePage
import "/preset/bsky/layers/sidebar-foryou.png" as railForYou
import "/preset/bsky/layers/sidebar-discover.png" as railDiscover
import "/preset/bsky/layers/sidebar-following.png" as railFollowing
import "/preset/bsky/layers/sidebar-video.png" as railVideo
import "/preset/bsky/layers/banner-phone.png" as phoneBanner


// ── Beats ────────────────────────────────────────────────────────────────────

beat open {
  duration 3.2s
  focus brandMark
  route stagedReveals
  label "Brand introduction"
}

beat compose {
  duration 3.4s
  focus composeShot
  zoom 1.05
  route cameraIntent
  transition cameraMove
  label "Say what matters"
}

beat feed {
  duration 4s
  focus feedShot
  zoom 1.1
  route cameraIntent
  transition cameraMove
  label "Choose the algorithm"
}

beat identity {
  duration 3.6s
  focus identityShot
  zoom 1.06
  route cameraIntent
  transition cameraMove
  label "Identity moves with you"
}

beat reach {
  duration 3.6s
  focus reachShot
  zoom 1.02
  route cameraIntent
  transition cameraMove
  label "Every device"
}

beat app {
  duration 3.4s
  focus appShot
  zoom 1.08
  route cameraIntent
  transition cameraMove
  label "One app"
}

beat close {
  duration 3.8s
  focus closeMark
  zoom 1
  route stagedReveals
  transition cameraMove
  label "Brand lockup"
}


// ── Atmosphere ───────────────────────────────────────────────────────────────

overlay atmosphere {
  layer background
  opacity 0
  backgroundEffect "particles(duration 25s opacity .16 intensity .5 gradientFrom #65B8FF gradientTo #1185FE)"
}


// ── open ─────────────────────────────────────────────────────────────────────

image brandMark {
  source bskyIcon
  center
  layer hero
  y -110
  width 240
  shadow 38
  beat open
}

text brandWordmark {
  value "BLUESKY"
  center
  layer text
  y 110
  width 1200
  size 104
  tracking 12
  weight 800
  color #FFFFFF
  beat open
  delay .45s
}

overlay brandRule {
  shape line
  layer details
  x -180
  y 186
  x2 360
  y2 0
  stroke #1185FE
  strokeWidth 3
  opacity .9
  animation "drawSVG(delay 1.1s duration .6s ease power3.out)"
}

text brandPromise {
  value "Social media as an open network."
  center
  layer text
  y 250
  width 900
  size 30
  weight 520
  color #9CCFFF
  beat open
  delay 1.5s
}

text brandProtocol {
  value "AN OPEN PROTOCOL, NOT A PLATFORM"
  center
  layer text
  y 330
  width 900
  size 19
  tracking 4
  weight 700
  color #4E86B8
  beat open
  delay 2.1s
}


// ── compose ──────────────────────────────────────────────────────────────────

text composeKicker {
  value "POST"
  center
  layer text
  x -540
  y -250
  width 720
  textAlign left
  size 22
  tracking 4
  weight 760
  color #65B8FF
  beat compose
}

text composeTitle {
  value "Say what\nmatters."
  center
  layer text
  x -540
  y -110
  width 720
  textAlign left
  size 76
  lineHeight 1
  weight 790
  color #FFFFFF
  beat compose
  delay .3s
}

text composeBody {
  value "Write it, publish it, own it.\nNo algorithm in the way."
  center
  layer text
  x -540
  y 70
  width 720
  textAlign left
  size 27
  lineHeight 1.3
  weight 500
  color #A8C3DA
  beat compose
  delay .65s
}

showcase composeShot {
  type browserShowcase
  media postCard
  width 820
  x 470
  y 0
  behavior push
  beat compose
  delay .95s
}


// ── feed ─────────────────────────────────────────────────────────────────────

text feedKicker {
  value "CUSTOM FEEDS"
  center
  layer text
  x -560
  y -300
  width 680
  textAlign left
  size 22
  tracking 4
  weight 760
  color #65B8FF
  beat feed
}

text feedTitle {
  value "Choose the\nalgorithm."
  center
  layer text
  x -560
  y -170
  width 680
  textAlign left
  size 70
  lineHeight 1
  weight 790
  color #FFFFFF
  beat feed
  delay .3s
}

text feedBody {
  value "Pick a custom feed, follow a list,\nor keep it chronological."
  center
  layer text
  x -560
  y -10
  width 680
  textAlign left
  size 26
  lineHeight 1.3
  weight 500
  color #A8C3DA
  beat feed
  delay .6s
}

layout feedChoices {
  type featureGrid
  columns 2
  gap 24
  width 660
  height 240
  x -560
  y 220
  beat feed
  delay .95s
}

image feedChoiceForYou {
  source railForYou
  parent feedChoices
}

image feedChoiceDiscover {
  source railDiscover
  parent feedChoices
}

image feedChoiceFollowing {
  source railFollowing
  parent feedChoices
}

image feedChoiceVideo {
  source railVideo
  parent feedChoices
}

showcase feedShot {
  type dashboardShowcase
  media feedApp
  width 900
  x 450
  y 0
  behavior push highlight
  focusX .5
  focusY .35
  beat feed
  delay .8s
}


// ── identity ─────────────────────────────────────────────────────────────────

text identityKicker {
  value "BUILT ON THE AT PROTOCOL"
  center
  layer text
  x 520
  y -280
  width 700
  textAlign left
  size 21
  tracking 4
  weight 760
  color #65B8FF
  beat identity
}

text identityTitle {
  value "Your identity\nmoves with you."
  center
  layer text
  x 520
  y -140
  width 700
  textAlign left
  size 64
  lineHeight 1.02
  weight 790
  color #FFFFFF
  beat identity
  delay .3s
}

text identityBody {
  value "Switch providers and keep your\nhandle, followers, and posts."
  center
  layer text
  x 520
  y 40
  width 700
  textAlign left
  size 26
  lineHeight 1.3
  weight 500
  color #A8C3DA
  beat identity
  delay .6s
}

text identityHandle {
  value "@you.bsky.social"
  center
  layer text
  x 520
  y 190
  width 700
  textAlign left
  size 30
  tracking 1
  weight 700
  color #65B8FF
  beat identity
  delay 1.9s
}

showcase identityShot {
  type browserShowcase
  media profilePage
  width 840
  x -480
  y 0
  behavior push
  beat identity
  delay .9s
}


// ── reach ────────────────────────────────────────────────────────────────────

text reachKicker {
  value "EVERY DEVICE"
  center
  layer text
  y -390
  width 900
  size 22
  tracking 4
  weight 760
  color #65B8FF
  beat reach
}

text reachTitle {
  value "Millions of people\nalready posting."
  center
  layer text
  y -250
  width 1200
  size 62
  lineHeight 1.05
  weight 790
  color #FFFFFF
  beat reach
  delay .3s
}

showcase reachShot {
  type phoneShowcase
  media phoneBanner
  width 380
  y 130
  behavior push
  beat reach
  delay .7s
}

text reachBody {
  value "iOS, Android, and the web — all on the same open network."
  center
  layer text
  y 430
  width 1100
  size 26
  weight 500
  color #A8C3DA
  beat reach
  delay 2.2s
}


// ── app ──────────────────────────────────────────────────────────────────────

showcase appShot {
  type laptopShowcase
  media feedApp
  width 1080
  y -40
  headline "One app. Your feeds. Your rules."
  behavior push
  beat app
}


// ── close ────────────────────────────────────────────────────────────────────

image closeMark {
  source bskyIcon
  center
  layer hero
  y -170
  width 150
  shadow 30
  beat close
}

text closeName {
  value "Bluesky"
  center
  layer text
  y -20
  width 1100
  size 92
  weight 800
  color #FFFFFF
  beat close
  delay .4s
}

text closeTagline {
  value "Open social, built around you."
  center
  layer text
  y 90
  width 1000
  size 30
  weight 520
  color #A8C3DA
  beat close
  delay .85s
}

overlay closeSurface {
  shape rect
  layer content
  y 230
  width 360
  height 78
  radius 39
  gradientFrom #65B8FF
  gradientTo #1185FE
  shadow 40
  opacity 0
  animation "buttonPop(delay 22.7s duration .5s ease power3.out)"
}

text closeUrl {
  value "bsky.app"
  center
  layer text
  y 230
  width 360
  size 32
  weight 760
  color #04121F
  beat close
  delay 1.6s
}


// ── Exits ────────────────────────────────────────────────────────────────────
//
// Beats never clear the composition, so each shot clears its own copy. Exits run
// about 75% of an arrival (0.35s against 0.46s) and lift as they go, per the
// doctrine. Each showcase leaves before the next one arrives, so two device
// frames never occupy the same slot at once.

animate brandMark {
  from { opacity 1 y -110 }
  to { opacity 0 y -140 }
  delay 2.75s
  duration .35s
  easing power2.in
}

animate brandWordmark {
  from { opacity 1 y 110 }
  to { opacity 0 y 84 }
  delay 2.75s
  duration .35s
  easing power2.in
}

animate brandRule {
  from { opacity .9 }
  to { opacity 0 }
  delay 2.75s
  duration .3s
  easing power2.in
}

animate brandPromise {
  from { opacity 1 y 250 }
  to { opacity 0 y 224 }
  delay 2.8s
  duration .35s
  easing power2.in
}

animate brandProtocol {
  from { opacity 1 y 330 }
  to { opacity 0 y 304 }
  delay 2.85s
  duration .35s
  easing power2.in
}

animate composeKicker {
  from { opacity 1 y -250 }
  to { opacity 0 y -276 }
  delay 6.15s
  duration .35s
  easing power2.in
}

animate composeTitle {
  from { opacity 1 y -110 }
  to { opacity 0 y -136 }
  delay 6.2s
  duration .35s
  easing power2.in
}

animate composeBody {
  from { opacity 1 y 70 }
  to { opacity 0 y 44 }
  delay 6.25s
  duration .35s
  easing power2.in
}

animate composeShot {
  from { opacity 1 }
  to { opacity 0 }
  delay 6.85s
  duration .4s
  easing power2.in
}

animate feedKicker {
  from { opacity 1 y -300 }
  to { opacity 0 y -326 }
  delay 10.15s
  duration .35s
  easing power2.in
}

animate feedTitle {
  from { opacity 1 y -170 }
  to { opacity 0 y -196 }
  delay 10.2s
  duration .35s
  easing power2.in
}

animate feedBody {
  from { opacity 1 y -10 }
  to { opacity 0 y -36 }
  delay 10.25s
  duration .35s
  easing power2.in
}

animate feedChoices {
  from { opacity 1 }
  to { opacity 0 }
  delay 10.25s
  duration .35s
  easing power2.in
}

animate feedShot {
  from { opacity 1 }
  to { opacity 0 }
  delay 10.25s
  duration .4s
  easing power2.in
}

animate identityKicker {
  from { opacity 1 y -280 }
  to { opacity 0 y -306 }
  delay 13.75s
  duration .35s
  easing power2.in
}

animate identityTitle {
  from { opacity 1 y -140 }
  to { opacity 0 y -166 }
  delay 13.8s
  duration .35s
  easing power2.in
}

animate identityBody {
  from { opacity 1 y 40 }
  to { opacity 0 y 14 }
  delay 13.85s
  duration .35s
  easing power2.in
}

animate identityHandle {
  from { opacity 1 y 190 }
  to { opacity 0 y 164 }
  delay 13.85s
  duration .35s
  easing power2.in
}

animate identityShot {
  from { opacity 1 }
  to { opacity 0 }
  delay 13.75s
  duration .4s
  easing power2.in
}

animate reachKicker {
  from { opacity 1 y -390 }
  to { opacity 0 y -416 }
  delay 17.35s
  duration .35s
  easing power2.in
}

animate reachTitle {
  from { opacity 1 y -250 }
  to { opacity 0 y -276 }
  delay 17.4s
  duration .35s
  easing power2.in
}

animate reachBody {
  from { opacity 1 y 430 }
  to { opacity 0 y 404 }
  delay 17.4s
  duration .35s
  easing power2.in
}

animate reachShot {
  from { opacity 1 }
  to { opacity 0 }
  delay 17.45s
  duration .35s
  easing power2.in
}

animate appShot {
  from { opacity 1 }
  to { opacity 0 }
  delay 20.8s
  duration .4s
  easing power2.in
}
