canvas {
  size 1920x1080
  fps 60
  duration 26.9s
  background #08090c
}

camera {
  zoom 1
  x 0
  y 0
}

theme {
  surface #15171c
  raised #20232a
  edge #30343d
  text #f8f8f5
  muted #9b9da4
  accent #57e6b1
  secondary #ff6547
  positive #57e6b1
  negative #ff6547
}

import "/preset/motionly/assets/svg/motionly-logo.svg" as motionlyLogo
import "/preset/motionly/assets/svg/codex-color.svg" as codexLogo
import "/preset/motionly/assets/svg/claude-code-color.svg" as claudeLogo
import "/preset/motionly/assets/svg/antigravity-color.svg" as antigravityLogo
import "/preset/motionly/assets/motionly-ui.png" as motionlyUI
import "/preset/motionly/assets/export-settings-ui.png" as exportCapture
import "/preset/motionly/bg-1-dark.png" as bgDark
import "/preset/motionly/bg-2.jpg" as bgTeal
import "/preset/motionly/bg-3.jpg" as bgAurora

scene direction {
  label "Direction"
  duration 4.1s
  transition cut
}

scene agents {
  label "Agents"
  duration 4.2s
  transition continuous
  transitionDuration 1.15s
}

scene product {
  label "Product tour"
  duration 10.6s
  clear
  transition continuous
  transitionDuration .8s
}

scene delivery {
  label "Delivery"
  duration 4s
  transition cut
}

scene finish {
  label "Finish"
  duration 4s
  transition continuous
  transitionDuration 1s
}

image directionBg {
  scene direction
  source bgAurora
  center
  layer background
  track 0
  width 2400
}

animate directionBg {
  from { x 0 y 0 scale 1.01 }
  to { x -18 y -8 scale 1.035 }
  duration 4.1s
  easing sine.inOut
}

text openingLead {
  scene direction
  value "Create editable motion with AI."
  center
  width 1680
  size 112
  weight 650
  color #f8f8f5
  animation "splitMaskWipe(split words duration 620ms stagger .05 exitAt 1.15s exitDuration 900ms exitDistance 760 exitEase sine.inOut ease power4.out)"
}

text openingAnswer {
  scene direction
  value "Then refine every detail"
  center
  width 1760
  size 96
  weight 650
  color #f8f8f5
  animation "slideTransition(split none direction up distance 180 delay 1.35s duration 850ms exitAt 3.2s exitDuration 700ms exitDirection left exitDistance 1400 exitEase power3.inOut ease power4.out)"
}

text openingWord {
  scene direction
  value "visually."
  center
  y 128
  width 900
  size 126
  weight 700
  color #f8f8f5
  animation "slideTransition(split none direction up distance 120 delay 1.7s duration 760ms exitAt 3.2s exitDuration 700ms exitDirection left exitDistance 1400 exitEase power3.inOut ease power4.out)"
}

image agentsBg {
  scene agents
  source bgTeal
  center
  layer background
  track 0
  width 2400
}

animate agentsBg {
  from { x 0 y 0 scale 1.01 }
  to { x 12 y -6 scale 1.025 }
  duration 4.2s
  easing sine.inOut
}

text agentsLine {
  scene agents
  value "Bring any"
  center
  y -300
  width 1720
  size 118
  weight 620
  color #f8f8f5
  animation "slideTransition(split none direction left duration 760ms distance 600 ease power4.out)"
}

text agentsWord {
  scene agents
  value "agent."
  center
  y -155
  width 980
  size 166
  weight 700
  color #57e6b1
  animation "slideUp(split none delay 520ms duration 760ms distance 140 ease power4.out)"
}

animate agentsWord__none_0 {
  from { scale 1 }
  to { scale 1.08 }
  duration .55s
  delay 1.65s
  easing power3.out
}

image codexAgent {
  scene agents
  source codexLogo
  x -460
  y 80
  width 196
  opacity 0
}

image claudeAgent {
  scene agents
  source claudeLogo
  x 0
  y 80
  width 190
  opacity 0
}

image antigravityAgent {
  scene agents
  source antigravityLogo
  x 460
  y 80
  width 196
  opacity 0
}

text codexLabel {
  scene agents
  value "Codex"
  x -460
  y 300
  width 360
  size 38
  weight 620
  color #f8f8f5
  animation "slideUp(split none delay 760ms duration 680ms distance 120 ease power4.out)"
}

text claudeLabel {
  scene agents
  value "Claude Code"
  x 0
  y 300
  width 360
  size 38
  weight 620
  color #f8f8f5
  animation "slideUp(split none delay 810ms duration 680ms distance 120 ease power4.out)"
}

text antigravityLabel {
  scene agents
  value "Antigravity"
  x 460
  y 300
  width 360
  size 38
  weight 620
  color #f8f8f5
  animation "slideUp(split none delay 852ms duration 680ms distance 120 ease power4.out)"
}

animate codexAgent {
  from { x -520 y 120 scale .96 opacity 1 rotation -2 }
  to { x -460 y 80 scale 1 opacity 1 rotation 0 }
  duration .52s
  delay .58s
  easing power4.out
}

animate claudeAgent {
  from { x 0 y 120 scale .96 opacity 1 }
  to { x 0 y 80 scale 1 opacity 1 }
  duration .5s
  delay .63s
  easing power4.out
}

animate antigravityAgent {
  from { x 520 y 120 scale .96 opacity 1 rotation 2 }
  to { x 460 y 80 scale 1 opacity 1 rotation 0 }
  duration .48s
  delay .672s
  easing power4.out
}

image productBg {
  scene product
  source bgDark
  center
  layer background
  track 0
  width 2400
}

animate productBg {
  from { x 0 y 0 scale 1.01 }
  to { x 0 y -8 scale 1.025 }
  duration 10.6s
  easing sine.inOut
}

text productLine {
  scene product
  value "Preview. Edit."
  center
  width 1740
  size 136
  weight 640
  color #f8f8f5
  animation "slideTransition(split none direction up duration 620ms distance 600 exitAt 1.12s exitDuration 560ms exitDistance 900 ease power4.out)"
}

text productWord {
  scene product
  value "Export."
  center
  y 132
  width 900
  size 176
  weight 700
  color #ff6547
  animation "neonGlowWipe(split none delay 420ms duration 620ms distance 72 exitAt 1.12s exitDuration 560ms exitDistance 900 ease power4.out)"
}

image productUI {
  scene product
  source motionlyUI
  center
  y 70
  width 1840
  shadow 54
  opacity 0
  perspective 1200
}

animate productUI {
  from { x 0 y 680 scale .86 rotationX -3 opacity 1 }
  to { x 0 y 70 scale .94 rotationX 0 opacity 1 }
  duration .62s
  delay 1.85s
  easing power4.out
}

animate productUI {
  from { x 0 y 70 scale .94 rotationX 0 opacity 1 }
  to { x 0 y 35 scale 1.04 rotationX 0 opacity 1 }
  duration .7s
  delay 2.55s
  easing power3.out
}

animate productUI {
  from { x 0 y 35 scale 1.04 opacity 1 }
  to { x 1050 y 480 scale 2.15 opacity 1 rotationY 2 }
  duration 1.15s
  delay 3.35s
  easing power3.inOut
}

animate productUI {
  from { x 1050 y 480 scale 2.15 opacity 1 rotationY 2 }
  to { x -1050 y 480 scale 2.15 opacity 1 rotationY -2 }
  duration 1.35s
  delay 5.35s
  easing power3.inOut
}

animate productUI {
  from { x -1050 y 480 scale 2.15 opacity 1 rotationY -2 }
  to { x 0 y -300 scale 2.15 opacity 1 rotationY 0 rotationX 1 }
  duration 1.25s
  delay 6.7s
  easing power3.inOut
}

animate productUI {
  from { x 0 y -300 scale 2.15 opacity 1 }
  to { x 0 y -40 scale 1.32 opacity 1 rotationX 0 }
  duration 1.3s
  delay 8s
  easing power3.inOut
}

animate productUI {
  from { x 0 y -40 scale 1.32 opacity 1 rotationY 0 }
  to { x -2200 y -40 scale 1.32 opacity 1 rotationY -2 }
  duration 1.15s
  delay 9.3s
  easing power3.inOut
}

image deliveryBg {
  scene delivery
  source bgAurora
  center
  layer background
  track 0
  width 2400
  animation "shapeWipe(direction right duration 650ms ease power4.out)"
}

animate deliveryBg {
  from { x 0 y 0 scale 1.01 }
  to { x 10 y -5 scale 1.025 }
  duration 4s
  easing sine.inOut
}

text deliveryLine {
  scene delivery
  value "Export when it is ready."
  center
  y -300
  width 1600
  size 132
  weight 650
  color #f8f8f5
  animation "expand(split none duration 720ms exitAt 2.65s exitDuration 500ms exitDistance 900 exitEase power3.in ease power4.out)"
}

image exportPanel {
  scene delivery
  source exportCapture
  center
  y 150
  width 850
  shadow 56
  opacity 0
}

animate exportPanel {
  from { x 0 y 150 scale .82 rotationX 8 opacity 1 }
  to { x 0 y 150 scale 1 rotationX 0 opacity 1 }
  duration .72s
  delay .42s
  easing power4.out
}

animate exportPanel {
  from { x 0 y 150 scale 1 opacity 1 }
  to { x 0 y 130 scale 1.04 opacity 1 }
  duration .5s
  delay 1.75s
  easing power3.out
}

animate exportPanel {
  from { x 0 y 130 scale 1.04 opacity 1 }
  to { x 0 y 100 scale 1.14 opacity 1 }
  duration .65s
  delay 3.1s
  easing power3.in
}

image finishBg {
  scene finish
  source bgTeal
  center
  layer background
  track 0
  width 2400
}

animate finishBg {
  from { x 0 y 0 scale 1.01 }
  to { x -10 y -5 scale 1.025 }
  duration 4s
  easing sine.inOut
}

image finalMark {
  scene finish
  source motionlyLogo
  center
  y -215
  width 176
  animation "heroLogo(duration 560ms ease power4.out)"
}

text finalLine {
  scene finish
  value "AI-native motion graphics editor."
  center
  y 55
  width 1740
  size 102
  weight 650
  color #f8f8f5
  animation "slideTransition(split none direction up delay 220ms duration 620ms distance 600 ease power4.out)"
}

animate finalMark {
  from { y -215 scale 1 }
  to { y -230 scale 1.05 }
  duration .8s
  delay 1.45s
  easing power3.inOut
}

animate finalMark {
  from { y -230 scale 1.05 }
  to { y -215 scale 1 }
  duration .8s
  delay 2.8s
  easing power3.out
}
