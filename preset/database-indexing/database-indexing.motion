// DATABASE INDEXING — 42-second editorial technical explainer
//
// Narration:
// "Imagine asking a database to find user 742. Without an index, it starts at
// the first row and checks rows one by one until it finds a match. As the table
// grows, that search does more work. An index creates a separate, sorted list
// of IDs with a pointer to each row. Now the database finds 742 in a few steps
// and jumps straight to the data. Reads become much faster, but indexes use
// storage and must be updated when data changes. Index the columns you search
// and join often—not every column."
//
// Editorial grammar:
// - White paper, black ink, database orange, quiet gray.
// - One query—WHERE id = 742—drives every chapter.
// - Tables, sorted lists, arrows, and query-plan evidence replace generic cards.
// - Every chapter pushes left like a new printed spread.

canvas {
  size 1920x1080
  fps 60
  duration 42s
  background #FFFFFF
}

theme {
  background #FFFFFF
  surface #F7F7F5
  raised #EFEFEB
  edge #111111
  text #111111
  muted #6B7280
  accent #FF7A00
  secondary #111111
  positive #16835A
  warning #FF7A00
  negative #D92D20
  ink #FFFFFF
  gradientFrom #FF7A00
  gradientTo #FF7A00
  displayFont "Space Grotesk, Inter, sans-serif"
  radius 2
  shadow 6
  duration .56s
  stagger .05s
  easing power4.out
}

overlay progressTrack {
  layer effects
  shape rect
  x -880
  y 505
  originX 0
  width 1760
  height 4
  fill #E5E7EB
  opacity 1
}

overlay progressInk {
  layer effects
  shape rect
  x -880
  y 505
  originX 0
  width 1760
  height 4
  fill #FF7A00
  opacity 1
  animation "progressFill(delay 0s duration 42s ease linear)"
}

