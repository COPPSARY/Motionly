// masonryGrid — Column-packed grid for many screenshots of differing height.
canvas {
  size 1920x1080
  fps 60
  duration 4.8s
}

camera {
  zoom 1
}

theme {
  accent #7CF7C5
}

beat compose {
  duration 1.6s
  focus showcase
  route stagedReveals
  label "screenshot gallery"
}

beat inspect {
  duration 1.6s
  focus showcase
  zoom 1.12
  route cameraIntent
  label "Look closer"
}

beat settle {
  duration 1.6s
  focus showcase
  zoom 1
  route cameraIntent
  label "Settle"
}

layout showcase {
  type masonryGrid
  columns 3
  gap 32
  beat compose
}

component masonryGridItem1 {
  parent showcase
  type browser
  label "Item 1"
}

component masonryGridItem2 {
  parent showcase
  type notification
  label "Item 2"
}

component masonryGridItem3 {
  parent showcase
  type chart
  label "Item 3"
}

component masonryGridItem4 {
  parent showcase
  type terminal
  label "Item 4"
}

component masonryGridItem5 {
  parent showcase
  type button
  label "Item 5"
}

component masonryGridItem6 {
  parent showcase
  type notification
  label "Item 6"
}

text caption {
  value "screenshot gallery"
  center
  layer text
  y 430
  size 30
  color #8B94A1
  beat compose
}
