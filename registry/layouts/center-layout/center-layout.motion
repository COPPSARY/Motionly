// centerLayout — A centered focal composition with optional supporting items.
canvas {
  size 1920x1080
  fps 60
  duration 4.8s
}

camera {
  zoom 1
}

theme {
  accent #7CF7C5
}

beat compose {
  duration 1.6s
  focus showcase
  route stagedReveals
  label "title card"
}

beat inspect {
  duration 1.6s
  focus showcase
  zoom 1.12
  route cameraIntent
  label "Look closer"
}

beat settle {
  duration 1.6s
  focus showcase
  zoom 1
  route cameraIntent
  label "Settle"
}

layout showcase {
  type centerLayout
  columns 1
  gap 40
  beat compose
}

component centerLayoutItem1 {
  parent showcase
  type button
  label "Item 1"
}

component centerLayoutItem2 {
  parent showcase
  type notification
  label "Item 2"
}

component centerLayoutItem3 {
  parent showcase
  type button
  label "Item 3"
}

text caption {
  value "title card"
  center
  layer text
  y 430
  size 30
  color #8B94A1
  beat compose
}
