// gallery — Two-row gallery with a wide first row.
canvas {
  size 1920x1080
  fps 60
  duration 4.8s
}

camera {
  zoom 1
}

theme {
  accent #7CF7C5
}

beat compose {
  duration 1.6s
  focus showcase
  route stagedReveals
  label "media wall"
}

beat inspect {
  duration 1.6s
  focus showcase
  zoom 1.12
  route cameraIntent
  label "Look closer"
}

beat settle {
  duration 1.6s
  focus showcase
  zoom 1
  route cameraIntent
  label "Settle"
}

layout showcase {
  type gallery
  columns 3
  gap 36
  beat compose
}

component galleryItem1 {
  parent showcase
  type browser
  label "Item 1"
}

component galleryItem2 {
  parent showcase
  type notification
  label "Item 2"
}

component galleryItem3 {
  parent showcase
  type chart
  label "Item 3"
}

text caption {
  value "media wall"
  center
  layer text
  y 430
  size 30
  color #8B94A1
  beat compose
}
