// logoWall — Dense grid of customer or integration logos.
canvas {
  size 1920x1080
  fps 60
  duration 4.8s
}

camera {
  zoom 1
}

theme {
  accent #7CF7C5
}

beat compose {
  duration 1.6s
  focus showcase
  route stagedReveals
  label "social proof"
}

beat inspect {
  duration 1.6s
  focus showcase
  zoom 1.12
  route cameraIntent
  label "Look closer"
}

beat settle {
  duration 1.6s
  focus showcase
  zoom 1
  route cameraIntent
  label "Settle"
}

layout showcase {
  type logoWall
  columns 5
  gap 56
  beat compose
}

component logoWallItem1 {
  parent showcase
  type logo
  label "Item 1"
}

component logoWallItem2 {
  parent showcase
  type logo
  label "Item 2"
}

component logoWallItem3 {
  parent showcase
  type logo
  label "Item 3"
}

component logoWallItem4 {
  parent showcase
  type logo
  label "Item 4"
}

component logoWallItem5 {
  parent showcase
  type logo
  label "Item 5"
}

component logoWallItem6 {
  parent showcase
  type logo
  label "Item 6"
}

text caption {
  value "social proof"
  center
  layer text
  y 430
  size 30
  color #8B94A1
  beat compose
}
