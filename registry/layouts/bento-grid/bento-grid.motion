// bentoGrid — Asymmetric grid with one large focal tile and smaller support tiles.
canvas {
  size 1920x1080
  fps 60
  duration 4.8s
}

camera {
  zoom 1
}

theme {
  accent #7CF7C5
}

beat compose {
  duration 1.6s
  focus showcase
  route stagedReveals
  label "feature showcase"
}

beat inspect {
  duration 1.6s
  focus showcase
  zoom 1.12
  route cameraIntent
  label "Look closer"
}

beat settle {
  duration 1.6s
  focus showcase
  zoom 1
  route cameraIntent
  label "Settle"
}

layout showcase {
  type bentoGrid
  columns 3
  gap 40
  beat compose
}

component bentoGridItem1 {
  parent showcase
  type chart
  label "Item 1"
}

component bentoGridItem2 {
  parent showcase
  type notification
  label "Item 2"
}

component bentoGridItem3 {
  parent showcase
  type terminal
  label "Item 3"
}

component bentoGridItem4 {
  parent showcase
  type button
  label "Item 4"
}

text caption {
  value "feature showcase"
  center
  layer text
  y 430
  size 30
  color #8B94A1
  beat compose
}
