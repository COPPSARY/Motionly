// deviceStack — Overlapping device fan with the center device in focus.
canvas {
  size 1920x1080
  fps 60
  duration 4.8s
}

camera {
  zoom 1
}

theme {
  accent #7CF7C5
}

beat compose {
  duration 1.6s
  focus showcase
  route stagedReveals
  label "multi-platform reveal"
}

beat inspect {
  duration 1.6s
  focus showcase
  zoom 1.12
  route cameraIntent
  label "Look closer"
}

beat settle {
  duration 1.6s
  focus showcase
  zoom 1
  route cameraIntent
  label "Settle"
}

layout showcase {
  type deviceStack
  columns 1
  gap 0
  beat compose
}

component deviceStackItem1 {
  parent showcase
  type phone
  label "Item 1"
}

component deviceStackItem2 {
  parent showcase
  type phone
  label "Item 2"
}

component deviceStackItem3 {
  parent showcase
  type phone
  label "Item 3"
}

text caption {
  value "multi-platform reveal"
  center
  layer text
  y 430
  size 30
  color #8B94A1
  beat compose
}
