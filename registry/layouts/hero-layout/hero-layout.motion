// heroLayout — One focal subject with stacked supporting copy beneath it.
canvas {
  size 1920x1080
  fps 60
  duration 4.8s
}

camera {
  zoom 1
}

theme {
  accent #7CF7C5
}

beat compose {
  duration 1.6s
  focus showcase
  route stagedReveals
  label "opening shot"
}

beat inspect {
  duration 1.6s
  focus showcase
  zoom 1.12
  route cameraIntent
  label "Look closer"
}

beat settle {
  duration 1.6s
  focus showcase
  zoom 1
  route cameraIntent
  label "Settle"
}

layout showcase {
  type heroLayout
  columns 1
  gap 56
  beat compose
}

component heroLayoutItem1 {
  parent showcase
  type website
  label "Item 1"
}

component heroLayoutItem2 {
  parent showcase
  type notification
  label "Item 2"
}

text caption {
  value "opening shot"
  center
  layer text
  y 430
  size 30
  color #8B94A1
  beat compose
}
