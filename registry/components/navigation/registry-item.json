    "source": "src/semantic/component-structures.ts"
  },
  "schema": {
    "label": {
      "type": "string",
      "docs": "Primary label slot."
    },
    "detail": {
      "type": "string",
      "docs": "Supporting detail slot."
    },
    "headline": {
      "type": "string",
      "docs": "Headline slot."
    },
    "cta": {
      "type": "string",
      "docs": "Action slot."
    },
    "source": {
      "type": "asset",
      "docs": "Optional real asset alias."
    },
    "width": {
      "type": "number",
      "docs": "Component width."
    },
    "x": {
      "type": "number",
      "docs": "Legacy component X position."
    },
    "y": {
      "type": "number",
      "docs": "Legacy component Y position."
    },
    "role": {
      "type": "string",
      "docs": "Semantic role."
    },
    "intent": {
      "type": "string",
      "docs": "Story intent."
    },
    "behavior": {
      "type": "list",
      "docs": "Built-in behaviors."
    },
    "variant": {
      "type": "string",
      "docs": "Visual variant: desktop, mobile, bottom, dock."
    },
    "motionPreset": {
      "type": "string",
      "docs": "Motion recipe: minimal, smooth, spring, premium."
    },
    "parent": {
