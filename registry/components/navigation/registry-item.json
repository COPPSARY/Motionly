      "docs": "Parent scene or group."
    },
    "color": {
      "type": "string",
      "docs": "Primary themed color override."
    },
    "accent": {
      "type": "string",
      "docs": "Accent override."
    },
    "surface": {
      "type": "string",
      "docs": "Surface override."
    },
    "delay": {
      "type": "time",
      "docs": "Entrance delay."
    },
    "duration": {
      "type": "time",
      "docs": "Entrance duration."
