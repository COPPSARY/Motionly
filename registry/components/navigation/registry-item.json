  "metadata": {
    "category": "mobile",
    "purpose": "Responsive navigation bar or dock.",
    "useCases": [
      "navigation bar",
      "mobile navigation",
      "bottom navigation",
      "dock",
      "sidebar navigation"
    ],
    "inputs": [
      "label",
      "labels"
    ],
    "interaction": "Items cascade and the active item lifts.",
    "recommendedSpacing": 16,
    "variants": [
      "desktop",
      "mobile",
      "bottom",
      "dock"
    ],
    "motionPresets": [
      "minimal",
      "smooth",
      "spring",
      "premium"
    ],
    "accessibility": "Preserve readable contrast, labels, focus order, and reduced-motion fallbacks.",
    "responsive": "Scales from its authored width and preserves touch-sized interactive targets."
  },
  "manifest": "components/navigation/registry-item.json"
