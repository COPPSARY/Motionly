// grid — A responsive equal-cell grid for general interface content.
canvas {
  size 1920x1080
  fps 60
  duration 4.8s
}

camera {
  zoom 1
}

theme {
  accent #7CF7C5
}

beat compose {
  duration 1.6s
  focus showcase
  route stagedReveals
  label "content grid"
}

beat inspect {
  duration 1.6s
  focus showcase
  zoom 1.12
  route cameraIntent
  label "Look closer"
}

beat settle {
  duration 1.6s
  focus showcase
  zoom 1
  route cameraIntent
  label "Settle"
}

layout showcase {
  type grid
  columns 3
  gap 40
  beat compose
}

component gridItem1 {
  parent showcase
  type button
  label "Item 1"
}

component gridItem2 {
  parent showcase
  type notification
  label "Item 2"
}

component gridItem3 {
  parent showcase
  type button
  label "Item 3"
}

text caption {
  value "content grid"
  center
  layer text
  y 430
  size 30
  color #8B94A1
  beat compose
}
