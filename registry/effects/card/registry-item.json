{
  "name": "card",
  "type": "motionly:effect",
  "title": "Card",
  "description": "Theme-styled card surface.",
  "tags": [
    "effect",
    "surface"
  ],
  "version": 1,
  "builtin": true,
  "implementation": {
    "name": "card",
    "source": "src/render/canvas-renderer.ts"
  },
  "schema": {
    "opacity": {
      "type": "number",
      "docs": "Effect opacity."
    },
    "intensity": {
      "type": "number",
      "docs": "Effect strength."
    },
    "duration": {
      "type": "time",
      "docs": "Loop duration."
    },
    "blendMode": {
      "type": "string",
      "docs": "Canvas blend mode."
    },
    "gradientFrom": {
      "type": "string",
      "docs": "Theme gradient start."
    },
    "gradientTo": {
      "type": "string",
      "docs": "Theme gradient end."
    },
    "color": {
      "type": "string",
      "docs": "Effect color."
    },
    "gridSize": {
      "type": "number",
      "docs": "Grid cell size."
    },
    "gridThickness": {
      "type": "number",
      "docs": "Grid line thickness."
    },
    "particleCount": {
      "type": "number",
      "docs": "Particle count."
    },
    "particleSize": {
      "type": "number",
      "docs": "Particle size."
    }
  },
  "defaults": {
    "opacity": 1,
    "intensity": 0.5,
    "duration": 0
  },
  "manifest": "effects/card/registry-item.json"
}
