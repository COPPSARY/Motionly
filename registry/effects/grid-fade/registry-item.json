{
  "name": "gridFade",
  "type": "motionly:effect",
  "title": "Grid Fade",
  "description": "Grid that fades toward the frame edge.",
  "tags": [
    "effect",
    "background"
  ],
  "version": 1,
  "builtin": true,
  "implementation": {
