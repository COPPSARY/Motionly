// appWindow — Native app window with a slim titlebar, for desktop application shots.
canvas {
  size 1920x1080
  fps 60
  duration 4.5s
}

camera {
  zoom 1
}

theme {
  accent #7CF7C5
}

beat reveal {
  duration 1.5s
  focus subject
  route stagedReveals
  label "desktop app"
}

beat push {
  duration 1.5s
  focus subject
  zoom 1.14
  route cameraIntent
  label "Push in"
}

beat settle {
  duration 1.5s
  focus subject
  zoom 1
  route cameraIntent
  label "Settle"
}

showcase subject {
  type appWindow
  headline "Show the real product"
  caption "Import your asset and set media to replace this frame."
  beat reveal
  behavior push
}

text hint {
  value "desktop app"
  center
  layer text
  y 470
  size 28
  color #8B94A1
  beat reveal
}
