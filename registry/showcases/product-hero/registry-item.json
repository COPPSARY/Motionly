{
  "name": "productHero",
  "type": "motionly:showcase",
  "title": "Product Hero",
  "description": "Hero presentation of one product asset with a glow bed and headline. Use for: opening shot, product reveal, brand promise. Presents: logo, ui, screenshot, illustration, photo.",
  "tags": [
    "showcase"
  ],
  "version": 1,
  "builtin": true,
  "implementation": {
    "name": "productHero",
    "source": "src/motion-system/showcase.ts"
  },
  "schema": {
    "parent": {
      "type": "string",
      "docs": "Parent scene, group, or layout."
    },
    "beat": {
      "type": "string",
      "docs": "Beat that paces this block."
    },
    "x": {
      "type": "number",
      "docs": "Offset from the parent center."
    },
    "y": {
      "type": "number",
      "docs": "Offset from the parent center."
    },
    "layer": {
      "type": "string",
      "docs": "Compositing layer."
    },
    "delay": {
      "type": "time",
      "docs": "Entrance delay, added to the beat start."
    },
    "opacity": {
      "type": "number",
      "docs": "Base opacity."
    },
    "scale": {
      "type": "number",
      "docs": "Base scale."
    },
    "center": {
      "type": "boolean",
      "docs": "Center in the parent coordinate space."
    },
    "start": {
      "type": "time",
      "docs": "Element start time."
    },
    "duration": {
      "type": "time",
      "docs": "Entrance duration."
    },
    "track": {
      "type": "string",
      "docs": "Timeline row."
    },
    "type": {
      "type": "string",
      "docs": "Showcase name."
    },
    "media": {
      "type": "asset",
      "docs": "Imported asset alias placed on the screen."
    },
    "headline": {
      "type": "string",
      "docs": "Headline beneath the subject."
    },
    "caption": {
      "type": "string",
      "docs": "Supporting caption."
    },
    "label": {
      "type": "string",
      "docs": "Step or category chip."
    },
    "width": {
      "type": "number",
      "docs": "Overall composition width."
    },
    "aspect": {
      "type": "number",
      "docs": "Optional source aspect ratio for exact screenshot framing."
    },
    "behavior": {
      "type": "list",
      "docs": "Showcase behaviors: perspective, tour, push, highlight, float, still."
    },
    "accent": {
      "type": "string",
      "docs": "Accent override."
    },
    "surface": {
      "type": "string",
      "docs": "Surface override."
    },
    "focusX": {
      "type": "number",
      "docs": "Highlight focus X inside the screen, 0-1."
    },
    "focusY": {
      "type": "number",
      "docs": "Highlight focus Y inside the screen, 0-1."
    },
    "focusScale": {
      "type": "number",
      "docs": "Scale used for the first directed product focus."
    },
    "focus2X": {
      "type": "number",
      "docs": "Optional second product focus X inside the screen, 0-1."
    },
    "focus2Y": {
      "type": "number",
      "docs": "Optional second product focus Y inside the screen, 0-1."
    },
    "focus2Scale": {
      "type": "number",
      "docs": "Scale used for the optional second product focus."
    }
  },
  "defaults": {
    "width": 1100,
    "behavior": "push",
    "duration": 0.75
  },
  "duration": 4.5,
  "files": [
    {
      "path": "registry/showcases/product-hero/product-hero.motion",
      "target": "compositions/product-hero.motion",
      "type": "motionly:composition"
    }
  ],
  "manifest": "showcases/product-hero/registry-item.json"
}
