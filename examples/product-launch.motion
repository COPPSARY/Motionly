// plan:
// 1. buildScene 0-7s     focal: code editor typing the feature; title sets context.
// 2. revealScene 7-14s   focal: browser with the shipped site; phone mirrors it beside.
// 3. growthScene 14-20s  focal: chart counting signups; closing wordmark.

canvas {
  size 1920x1080
  fps 60
  duration 20s
  background #0B0908
}

scene buildScene {
  start 0s
  duration 7s
  exit .5s
  cameraZoom 1
}

text buildTitle {
  parent buildScene
  value "Nightly. Notes that write themselves."
  center
  y -420
  width 1300
  height 90
  textAlign center
  verticalAlign middle
  size 52
  weight 660
  color #F5F0EA
  opacity 0
}

animate buildTitle {
  from { opacity 0 y -390 blur 8 }
  to { opacity 1 y -420 blur 0 }
  duration .8s
  delay .25s
  easing power3.out
}

component editor {
  parent buildScene
  type codeeditor
  role main
  intent introduce
  label "capture.ts"
  x 0
  y 40
  width 860
  accent #E8A87C
  surface #14100D
  delay .6s
}

animate buildScene {
  from { cameraZoom .98 cameraY 12 }
  to { cameraZoom 1.05 cameraY -8 }
  duration 6.8s
  delay 0s
  easing power2.inOut
}

scene revealScene {
  start 7s
  duration 7s
  enter .4s
  exit .5s
  cameraZoom 1
}

effect revealGlow {
  parent revealScene
  effect aurora
  layer background
  opacity .14
  intensity .5
}

component siteBrowser {
  parent revealScene
  type browser
  role main
  intent focus
  url "nightly.app"
  headline "Remember everything"
  cta "Try Nightly"
  x -240
  y 0
  width 900
  accent #E8A87C
  surface #14100D
  connects companionPhone
  relationship sync
  delay .4s
}

component companionPhone {
  parent revealScene
  type phone
  role supporting
  intent support
  label "Nightly"
  x 560
  y 40
  width 260
  accent #E8A87C
  surface #14100D
  delay 1.4s
}

animate revealScene {
  from { cameraZoom 1.04 cameraX 40 }
  to { cameraZoom .99 cameraX -30 }
  duration 6.8s
  delay 7s
  easing power2.inOut
}

scene growthScene {
  start 14s
  duration 6s
  enter .4s
  cameraZoom 1
}

component signupChart {
  parent growthScene
  type chart
  role main
  intent resolve
  label "Signups this week"
  countTo 48200
  x 0
  y -60
  width 720
  accent #E8A87C
  surface #14100D
  delay .4s
}

text growthClose {
  parent growthScene
  value "Launch yours with Motionly."
  center
  y 360
  width 1100
  height 80
  textAlign center
  verticalAlign middle
  size 42
  weight 620
  color #F5F0EA
  opacity 0
}

animate growthClose {
  from { opacity 0 y 390 }
  to { opacity 1 y 360 }
  duration .8s
  delay 2.2s
  easing power3.out
}

animate growthScene {
  from { cameraZoom 1.06 }
  to { cameraZoom .99 }
  duration 5.8s
  delay 14s
  easing power3.out
}
