// plan:
// 1. infraScene 0-8s      focal: cloud platform; server + database connect and receive data.
// 2. insightScene 8-15s   focal: live dashboard; metrics and chart carry the story.
// 3. shipScene 15-20s     focal: deploy button; cursor clicks, toast confirms, headline closes.

canvas {
  size 1920x1080
  fps 60
  duration 20s
  background #070A10
}

scene infraScene {
  start 0s
  duration 8s
  exit .5s
  cameraZoom 1
}

effect infraParticles {
  parent infraScene
  effect particles
  layer background
  opacity .16
  intensity .5
  particleCount 60
  particleSize 2
}

text infraTitle {
  parent infraScene
  value "One platform. Every workload."
  center
  y -420
  width 1200
  height 90
  textAlign center
  verticalAlign middle
  size 54
  weight 660
  color #F2F5F9
  opacity 0
}

animate infraTitle {
  from { opacity 0 y -390 blur 8 }
  to { opacity 1 y -420 blur 0 }
  duration .8s
  delay .3s
  easing power3.out
}

component platformCloud {
  parent infraScene
  type cloud
  role main
  intent introduce
  behavior premiumReveal float glow
  x 0
  y -110
  width 300
  color #8AB4FF
  accent #7CF7C5
  connects apiServer dataStore
  relationship dataFlow
  delay .6s
}

component apiServer {
  parent infraScene
  type server
  role supporting
  intent support
  behavior stackReveal activate
  x -430
  y 210
  width 170
  color #E8ECF2
  accent #7CF7C5
  label "API"
  delay 1.5s
}

component dataStore {
  parent infraScene
  type database
  role supporting
  intent support
  behavior stackReveal pulse
  x 430
  y 210
  width 170
  color #E8ECF2
  accent #8AB4FF
  label "Postgres"
  delay 1.8s
}

animate infraScene {
  from { cameraZoom .97 cameraY 14 }
  to { cameraZoom 1.05 cameraY -10 }
  duration 7.8s
  delay 0s
  easing power2.inOut
}

scene insightScene {
  start 8s
  duration 7s
  enter .4s
  exit .5s
  cameraZoom 1
}

effect insightGrid {
  parent insightScene
  effect grid
  layer background
  opacity .12
  gridSize 72
  gridThickness 1
}

component liveBoard {
  parent insightScene
  type dashboard
  role main
  intent focus
  label "Production"
  values "99.98%  248ms  1.2M"
  labels "Uptime  P95 latency  Requests"
  x 0
  y -40
  width 760
  accent #7CF7C5
  surface #0D1219
  delay .4s
}

text insightCaption {
  parent insightScene
  value "See everything the moment it happens."
  center
  y 400
  width 1100
  height 80
  textAlign center
  verticalAlign middle
  size 40
  weight 560
  color #AAB4C2
  opacity 0
}

animate insightCaption {
  from { opacity 0 y 430 }
  to { opacity 1 y 400 }
  duration .8s
  delay 2.4s
  easing power3.out
}

animate insightScene {
  from { cameraZoom 1.03 cameraX 30 }
  to { cameraZoom .99 cameraX -20 }
  duration 6.8s
  delay 8s
  easing power2.inOut
}

scene shipScene {
  start 15s
  duration 5s
  enter .4s
  cameraZoom 1
}

component shipButton {
  parent shipScene
  type button
  role main
  label "Ship it"
  x 0
  y -40
  width 280
  color #7C5CFF
  accent #9F8CFF
  delay .4s
}

component shipCursor {
  parent shipScene
  type cursor
  layer details
  clicks shipButton
  clickAt 1.8s
  x 330
  y 160
}

component shipToast {
  parent shipScene
  type notification
  layer details
  reactsTo shipButton
  label "Deployed to production"
  detail "Rollout completed in 12s."
  x 0
  y -220
  width 460
  accent #7CF7C5
  color #7CF7C5
}

text shipTagline {
  parent shipScene
  value "cloudly.dev"
  center
  y 320
  width 500
  height 60
  textAlign center
  verticalAlign middle
  size 26
  weight 580
  tracking 2
  color #8E97A5
  opacity 0
}

animate shipTagline {
  from { opacity 0 y 345 }
  to { opacity 1 y 320 }
  duration .7s
  delay 2.6s
  easing power3.out
}

animate shipScene {
  from { cameraZoom 1.08 }
  to { cameraZoom 1 }
  duration 4.8s
  delay 15s
  easing power3.out
}
